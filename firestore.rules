rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow get, list: if ownsExistingItem();
      allow create: if ownsIncomingItem();
      allow update: if ownsExistingItem() && ownsIncomingItem();
      allow delete: if ownsExistingItem();
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function ownsExistingItem() {
    return isSignedIn() && resource.data.ownerId == request.auth.uid;
  }

  function ownsIncomingItem() {
    return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
  }
}
